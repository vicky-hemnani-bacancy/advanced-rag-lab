# Copy to .env and fill in. .env is git-ignored; never commit real keys.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest

# Gemini key from https://aistudio.google.com/apikey (extra keys are rotated automatically on quota/overload errors)
GEMINI_API_KEY=your-gemini-key
# GEMINI_API_KEY_2=your-second-key

# Optional: only needed for chart captioning at ingest time, or to run Groq models instead of Gemini
# GROQ_API_KEY=your-groq-key
VISION_MODEL=qwen/qwen3.8-27b
