 {
  "id": "gep-2",
  "doc": "gep",
  "official": true,
  "q": "What does Chapter 3 say about sovereign debt in developing economies?",
  "mode": "advanced",
  "pages": [
   109,
   111,
   109,
   116,
   113,
   133
  ],
  "scores": [
   3.99,
